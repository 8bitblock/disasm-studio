  <PropertyGroup>
    <_DsGameMakerHelperPath>$(ProjectDir)build\$(Platform)\$(Configuration)\GameMakerHelper.dll</_DsGameMakerHelperPath>
    <_DsGameMakerResourcePath>$([System.String]::Copy('$(_DsGameMakerHelperPath)').Replace('\','/'))</_DsGameMakerResourcePath>
  </PropertyGroup>
  <Target Name="DsPrepareGameMakerHelperResource" BeforeTargets="ResourceCompile" DependsOnTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(_DsGameMakerHelperPath)')" Text="The built-in GameMaker helper must be built before application resources." />
    <GetFileHash Files="$(_DsGameMakerHelperPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_DsGameMakerHelperHash" />
    </GetFileHash>
    <PropertyGroup><_DsGameMakerHelperDigest>@(_DsGameMakerHelperHash->'%(FileHash)')</_DsGameMakerHelperDigest></PropertyGroup>
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(IntDir)GameMakerHelperResource.rc"
                      Lines="// Helper SHA256 $(_DsGameMakerHelperDigest);IDR_GML_HELPER RCDATA &quot;$(_DsGameMakerResourcePath)&quot;"
                      Encoding="UTF-8" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><FileWrites Include="$(IntDir)GameMakerHelperResource.rc" /></ItemGroup>
  </Target>
  <Target Name="DsVerifyGameMakerHelperResource" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup><DsPowerShell Condition="'$(DsPowerShell)' == ''">powershell</DsPowerShell></PropertyGroup>
    <Exec Command="&quot;$(DsPowerShell)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tests\verify_gamemaker_helper_resource.ps1&quot; -Executable &quot;$(TargetPath)&quot; -HelperDll &quot;$(_DsGameMakerHelperPath)&quot;" />
  </Target>

  <!-- The stock vcpkg MSBuild target inherits its compiler selection from the
       build-node environment, and its stamp only watches manifest/config files.
       Bind that environment to this project's compiler and include the identity
       in the stock target's incremental inputs. -->
  <PropertyGroup>
    <_DsVcpkgVisualStudioPath>$([System.Text.RegularExpressions.Regex]::Replace('$(VSInstallDir)', '[\\/]+$', ''))</_DsVcpkgVisualStudioPath>
    <_DsVcpkgToolchainIdentityFile>$(IntDir)vcpkg-toolchain-identity.txt</_DsVcpkgToolchainIdentityFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(VcpkgEnabled)' == 'true' and '$(VcpkgEnableManifest)' == 'true' and '$(VcpkgManifestInstall)' == 'true'">
    <_ZVcpkgInstallManifestDependenciesInputs Include="$(ProjectDir)triplets\x64-windows-static.cmake" />
    <_ZVcpkgInstallManifestDependenciesInputs Include="$(_DsVcpkgToolchainIdentityFile)" />
    <_ZVcpkgInstallManifestDependenciesInputs
      Include="$(VSInstallDir)VC\Auxiliary\Build\Microsoft.VCToolsVersion.v143.default.txt"
      Condition="Exists('$(VSInstallDir)VC\Auxiliary\Build\Microsoft.VCToolsVersion.v143.default.txt')" />
  </ItemGroup>
  <Target Name="DsPrepareVcpkgToolchainIdentity"
          BeforeTargets="VcpkgInstallManifestDependencies"
          Condition="'$(VcpkgEnabled)' == 'true' and '$(VcpkgEnableManifest)' == 'true' and '$(VcpkgManifestInstall)' == 'true'">
    <Error Text="DisasmStudio requires an active Visual Studio instance for vcpkg manifest installation."
           Condition="'$(_DsVcpkgVisualStudioPath)' == ''" />
    <Error Text="The active Visual Studio instance does not contain v143 $(VCToolsVersion)."
           Condition="'$(VCToolsVersion)' == '' or !Exists('$(_DsVcpkgVisualStudioPath)\VC\Tools\MSVC\$(VCToolsVersion)\bin\Hostx64\x64\cl.exe')" />
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(_DsVcpkgToolchainIdentityFile)"
                      Lines="VS=$(_DsVcpkgVisualStudioPath)|v143=$(VCToolsVersion)"
                      Encoding="UTF-8"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <SetEnv Name="VCPKG_VISUAL_STUDIO_PATH"
            Value="$(_DsVcpkgVisualStudioPath)"
            Prefix="false" />
    <SetEnv Name="DS_VCPKG_PLATFORM_TOOLSET_VERSION"
            Value="$(VCToolsVersion)"
            Prefix="false" />
    <Message Text="Binding vcpkg to VS '$(_DsVcpkgVisualStudioPath)', v143 $(VCToolsVersion)."
             Importance="High" />
  </Target>
</Project>
